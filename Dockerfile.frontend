# Stage 1: Builder (instala dependencias y prepara el entorno)
FROM node:22 AS builder

WORKDIR /app

# Copia solo los archivos de dependencias para caching
COPY package*.json ./

# Instala dependencias (usa ci para installs determinísticos y reproducibles)
RUN npm ci

# Copia el resto del código (excluyendo node_modules gracias a .dockerignore)
COPY . .

# Stage 2: Runtime (más liviano, usa slim para reducir tamaño)
FROM node:22-slim

WORKDIR /app

# Copia dependencias instaladas del builder
COPY --from=builder /app/node_modules ./node_modules

# Copia el código fuente (en dev mode, los volumes sobrescribirán esto)
COPY . .

# Expone el puerto (opcional, pero buena práctica)
EXPOSE 5173

# CMD para modo dev (mantiene tu lógica actual con Vite dev server)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]