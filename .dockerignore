# Dependencias que se instalan dentro del contenedor
node_modules/

# Archivos de build y compilación (se generan en el contenedor)
dist/
build/

# Logs y carpetas temporales
*.log
logs/
tmp/
temp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Historial de Git y configuraciones del IDE
.git/
.vscode/
.idea/

# Datos persistentes de Docker
postgres_data/

# Archivos de entorno locales (sensibles y específicos de la máquina)
.env
.env*
!.env.example

# Artefactos de pruebas
coverage/

# Archivos de sistema operativo
.DS_Store
Thumbs.db